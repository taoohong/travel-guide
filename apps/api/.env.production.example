# Copy to the server-side /opt/travel-guide/shared/.env and replace every placeholder there.
# Keep production credentials out of this repository and all build archives.
MODE=production
NODE_ENV=production
HOST=0.0.0.0
PORT=3100
APP_VERSION=replace_with_release_id
DATABASE_URL=postgresql://travel_guide:SET_ON_SERVER@postgres:5432/travel_guide?schema=public
AUTH_SECRET=GENERATE_A_STRONG_SECRET_ON_SERVER
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DEV_AUTH_ENABLED=false
UPLOAD_ROOT_DIR=/data/travel-guide/uploads
STATIC_BASE_URL=https://yuto.org.cn/travel-guide/static
CORS_ORIGINS=https://yuto.org.cn
DEMO_ADMIN_PASSWORD=
