{
  "name": "@travel-guide/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "esbuild ./src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main.cjs --external:@nestjs/* --external:@prisma/client --external:sharp --external:zod --external:reflect-metadata --external:rxjs --external:rxjs/*",
    "build:prod": "pnpm run build",
    "start": "node dist/main.cjs",
    "dev": "tsx src/main.ts",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "seed": "node node_modules/prisma/build/index.js db seed",
    "db:verify": "tsx scripts/verify-db.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@prisma/client": "6.19.3",
    "@travel-guide/constants": "workspace:*",
    "@travel-guide/core": "workspace:*",
    "@travel-guide/types": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.23",
    "@types/multer": "1.4.12",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
